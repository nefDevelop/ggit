# ##########################################
# Ggit Security & Global Standard
# Protección contra fugas de secretos y basura de sistema
# ##########################################

# --- Secretos y Entornos ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.crt
# Secretos de frameworks
.vercel
.netlify
.serverless/
auth.json

# --- Basura de Sistema (Cross-Platform) ---
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- IDEs y Editores ---
.vscode/
!.vscode/extensions.json
.idea/
*.iws
*.sublime-project
*.sublime-workspace

# --- Logs y Temporales ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
tmp/

# --- Bloqueos de Dependencias ---
# No ignoramos lockfiles por defecto, pero sí sus archivos temporales
.pnpm-debug.log*

# ##########################################
