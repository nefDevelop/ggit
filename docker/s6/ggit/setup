#!/bin/sh

if ! test -d ~git/.ssh; then
    gosu "$USER" mkdir -p ~git/.ssh
    chmod 700 ~git/.ssh
fi

if ! test -f ~git/.ssh/environment; then
    echo "GGIT_CUSTOM=${GGIT_CUSTOM}" > ~git/.ssh/environment
    chmod 600 ~git/.ssh/environment
fi

cd /app/ggit || exit 1

# Link volumed data with app data
ln -sfn /data/log  ./log
ln -sfn /data/data ./data

# Backward Compatibility with Ggit Container v0.6.15
ln -sfn /data/repositories /home/git/ggit-repositories

chmod 0755 /data ~git/
