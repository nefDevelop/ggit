#!/bin/sh

if ! test -d ~git/.ssh; then
    gosu "$USER" mkdir -p ~git/.ssh
    chmod 700 ~git/.ssh
fi

if ! test -f ~git/.ssh/environment; then
    gosu "$USER" echo "GOGS_CUSTOM=${GOGS_CUSTOM}" > ~git/.ssh/environment
    chmod 600 ~git/.ssh/environment
fi

cd /app/ggit || exit 1

# Link volumed data with app data
ln -sfn /data/ggit/log  ./log
ln -sfn /data/ggit/data ./data

# Backward Compatibility with Ggit Container v0.6.15
ln -sfn /data/git /home/git

chmod 0755 /data /data/ggit ~git/
