<script lang="ts">
    import { i18n } from '$lib/i18n.svelte.ts';

    const availableLanguages = [
        { code: 'en-US', name: 'English' },
        { code: 'es-ES', name: 'Español' },
        { code: 'vi-VN', name: 'Tiếng Việt' },
        { code: 'cs-CZ', name: 'Čeština' },
        { code: 'ro-RO', name: 'Română' },
        { code: 'gl-ES', name: 'Galego' },
    ];

    function changeLanguage(event: Event) {
        const select = event.currentTarget as HTMLSelectElement;
        i18n.init(select.value);
    }
</script>

<div class="language-selector-container">
    <div class="selector-info">
        <span class="material-symbols-rounded">language</span>
        <div class="text-info">
            <span class="selector-label">Language</span>
            <p class="selector-hint">Choose your preferred language for the interface.</p>
        </div>
    </div>
    <select id="lang-select" onchange={changeLanguage} value={i18n.locale}>
        {#each availableLanguages as lang}
            <option value={lang.code}>{lang.name}</option>
        {/each}
    </select>
</div>

