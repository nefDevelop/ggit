{{template "common/header" .}}
	<p style="font-size: 18px; font-weight: 700; color: #1a237e;">
		{{.Doer.DisplayName}} mentioned you:
	</p>
	
	<div style="background-color: #f8f9fa; border-left: 4px solid #3f51b5; padding: 15px; margin: 20px 0; font-style: italic;">
		{{.Body | Str2HTML}}
	</div>

	<div style="text-align: center; margin-top: 30px;">
		<a href="{{.Link}}" class="btn-capsule">Respond to Mention</a>
	</div>
{{template "common/footer" .}}
