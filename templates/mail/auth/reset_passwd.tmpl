{{template "common/header" .}}
	<p style="font-size: 20px; font-weight: 700; margin-bottom: 20px;">Hi {{.Username}},</p>
	<p>We received a request to reset your password for your <b>{{AppName}}</b> account.</p>
	<p>Please click the button below to choose a new password. This link will expire in <b>{{.ResetPwdCodeLives}} hours</b>.</p>
	
	<div style="text-align: center;">
		<a href="{{AppURL}}user/reset_password?code={{.Code}}" class="btn-capsule">Reset Password</a>
	</div>

	<p style="font-size: 14px; color: #7a7a7a;">
		If you did not request this, you can safely ignore this email. Your password will not change until you access the link above and create a new one.
	</p>
	<div class="code-block">
		{{AppURL}}user/reset_password?code={{.Code}}
	</div>
{{template "common/footer" .}}
