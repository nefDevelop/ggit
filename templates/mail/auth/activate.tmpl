{{template "common/header" .}}
	<p style="font-size: 20px; font-weight: 700; margin-bottom: 20px;">Hi {{.Username}},</p>
	<p>Thanks for registering at <b>{{AppName}}</b>! We're excited to have you on board.</p>
	<p>Please click the button below to verify your email address and activate your account. This link will remain active for <b>{{.ActiveCodeLives}} hours</b>.</p>
	
	<div style="text-align: center;">
		<a href="{{AppURL}}user/activate?code={{.Code}}" class="btn-capsule">Activate Account</a>
	</div>

	<p style="font-size: 14px; color: #7a7a7a;">
		Not working? Try copying and pasting the following link into your browser:
	</p>
	<div class="code-block">
		{{AppURL}}user/activate?code={{.Code}}
	</div>
{{template "common/footer" .}}
