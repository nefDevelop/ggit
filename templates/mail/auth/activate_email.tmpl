{{template "common/header" .}}
	<p style="font-size: 20px; font-weight: 700; margin-bottom: 20px;">Hi {{.Username}},</p>
	<p>You've requested to change your email address on <b>{{AppName}}</b>.</p>
	<p>Please click the button below to verify your new email address: <code>{{.Email}}</code>. This link will expire in <b>{{.ActiveCodeLives}} hours</b>.</p>
	
	<div style="text-align: center;">
		<a href="{{AppURL}}user/activate_email?code={{.Code}}&email={{.Email}}" class="btn-capsule">Verify Email Address</a>
	</div>

	<p style="font-size: 14px; color: #7a7a7a;">
		Not working? Try copying and pasting the following link into your browser:
	</p>
	<div class="code-block">
		{{AppURL}}user/activate_email?code={{.Code}}&email={{.Email}}
	</div>
{{template "common/footer" .}}
