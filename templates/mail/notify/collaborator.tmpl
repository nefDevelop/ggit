{{template "common/header" .}}
	<p style="font-size: 20px; font-weight: 700; margin-bottom: 20px;">Collaborator Invitation</p>
	<p>You have been added as a collaborator to the repository: <code style="padding: 2px 6px; background: #eee; border-radius: 4px;">{{.RepoName}}</code></p>
	
	<div style="text-align: center; margin-top: 30px;">
		<a href="{{.Link}}" class="btn-capsule">View Repository</a>
