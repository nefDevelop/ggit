{{template "base/header" .}}
<div class="error-container">
    <div class="error-card">
        <div class="error-badge">
            <div class="glitch-text" data-text="404">404</div>
        </div>
        <h1 class="error-title">Ruta no encontrada</h1>
        <p class="error-desc">Parece que el código que buscas se ha movido a otra rama o nunca existió.</p>
        <div class="error-actions">
            <a href="{{AppSubUrl}}/" class="btn-primary">
                Volver al Inicio
            </a>
        </div>
    </div>
</div>

<style>
    .error-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        padding: 2rem;
    }
    .error-card {
        background: var(--island-bg, #1a1c1e);
        border: 1px solid var(--border-color, #44474a);
        border-radius: 28px;
        padding: 3rem;
        max-width: 500px;
        width: 100%;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .error-badge {
        margin-bottom: 2rem;
        color: #d0e4ff;
    }
    .glitch-text {
        font-size: 5rem;
        font-weight: 900;
        letter-spacing: 0.5rem;
    }
    .error-title {
        font-size: 1.75rem;
        color: #e2e2e6;
        margin-bottom: 1rem;
    }
    .error-desc {
        color: #c2c6cf;
        margin-bottom: 2.5rem;
    }
    .btn-primary {
        background: #004a77;
        color: #d0e4ff;
        padding: 0.75rem 2rem;
        border-radius: 100px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-primary:hover {
        background: #005f98;
        transform: translateY(-2px);
    }
</style>
{{template "base/footer" .}}
