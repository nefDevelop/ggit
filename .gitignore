custom/
data/*
!data/README.md

# Test results and reports
/frontend/playwright-report/
/frontend/test-results/

# Artefactos de runtime que dejan los procesos de prueba. .backend.pid llego a
# versionarse por un "git add -A" y_publicaba el PID del servidor en el
# repositorio.
/.backend.pid
/.frontend.pid
/.backend.log
/.frontend.log

# IDEs y Sistema
.idea/
