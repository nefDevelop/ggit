# pm/ o cualquier otro gestor de paquetes
package-lock.json
pnpm-lock.yaml
yarn.lock

# Logs
log/
*.log

# Generado por "make test-e2e": lo copia desde conf/app.ini y lo borra al
# terminar. Versionarlo arrastraba el SECRET_KEY autogenerado al repositorio.
conf/app.test.ini

# Entorno aislado de "make test-e2e". Antes se escribia dentro de data/, que es
# justo el directorio que hay que dejar intacto.
/data/test-e2e/
